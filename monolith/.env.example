# Propel stack (docker-compose) — copy to .env to override defaults.
# Every value here already has a fallback in docker-compose.yml, so an empty
# .env still boots. Set OWNER_* to your own name/email; there is no login.

# ── Owner identity (single-user tool, no auth) ───────────────────────────────
OWNER_FIRST_NAME=Me
OWNER_LAST_NAME=
OWNER_EMAIL=me@localhost

# ── Host ports ────────────────────────────────────────────────────────────────
FRONTEND_PORT=4200
GATEWAY_PORT=8080
MONOLITH_PORT=5000
MONOLITH_DB_PORT=5432
AGENTS_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Local embeddings (optional, heavy) ───────────────────────────────────────
# The default `agents` image is light (~2 GB) and uses API embeddings. For local
# sentence-transformers embeddings, run the heavy sidecar and point the monolith
# at it:
#   docker compose --profile local-embeddings up -d
#   EMBEDDINGS_URL=http://agents-embeddings:8000
# AGENTS_EMBEDDINGS_PORT=8007

# ── Gmail token encryption ────────────────────────────────────────────────────
# AES key for encrypting stored Gmail OAuth tokens (mailbox/email features).
# A stable default lives in docker-compose.yml; override to rotate. Generate with:
#   openssl rand -base64 32
# GMAIL_TOKEN_ENCRYPTION_KEY=

# ── MinIO credentials ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Docker network name ───────────────────────────────────────────────────────
CV_NETWORK=cv-network

# LLM/provider keys live in monolith/agents/.env — not here.
