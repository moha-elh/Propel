# Propel Agents — copy to .env and fill in your keys.
# In Docker, docker-compose overrides BACKEND_BASE_URL / MINIO_ENDPOINT / DATABASE_URL.

# ── LLM Providers ─────────────────────────────────────────────────────────────
# OpenRouter is first-choice for direct AI (draft/autofill). Leave empty to fall
# back to OPENAI_API_KEY. At least one provider key is needed for AI features.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Per-provider default chat models (final fallback; live catalog wins)
OMNIROUTE_MODEL=auto/best-coding
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-large-latest

# Embeddings (local sentence-transformers — no API key; downloaded on first use)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:5000

# ── SMTP (contact agent) — fill to send real email ───────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── MinIO (template agent) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false

# ── CV Optimizer chat history (Postgres) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_monolith
