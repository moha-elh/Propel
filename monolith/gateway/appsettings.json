{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "user-content-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/user-content/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/{**remainder}" }
        ]
      },
      "workflow-route": {
        "ClusterId": "workflow-cluster",
        "Match": { "Path": "/api/workflows/{**catch-all}" }
      },
      "application-route": {
        "ClusterId": "application-cluster",
        "Match": { "Path": "/api/applications/{**catch-all}" }
      },
      "job-offer-route": {
        "ClusterId": "job-offer-cluster",
        "Match": { "Path": "/api/job-offers/{**catch-all}" }
      },
      "reminder-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/reminders/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "cv-route": {
        "ClusterId": "cv-cluster",
        "Match": { "Path": "/api/cv/{**catch-all}" }
      },
      "agents-route": {
        "ClusterId": "workflow-cluster",
        "Match": { "Path": "/api/agents/{**catch-all}" }
      },
      "vectors-route": {
        "ClusterId": "workflow-cluster",
        "Match": { "Path": "/api/vectors/{**catch-all}" }
      },
      "gmail-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/gmail/{**catch-all}" }
      },
      "contacts-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/contacts/{**catch-all}" }
      },
      "email-schedules-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/email-schedules/{**catch-all}" }
      },
      "mailbox-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/mailbox/{**catch-all}" }
      },
      "companies-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/companies/{**catch-all}" }
      },
      "imports-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/imports/{**catch-all}" }
      },
      "bime-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/bime/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:03:00" }
      },
      "search-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:01:00" }
      },
      "embeddings-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/embeddings/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:01:00" }
      },
      "llm-settings-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/llm-settings/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:01:00" }
      },
      "categories-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "autofill-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/autofill/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:03:00" }
      },
      "direct-ai-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/direct-ai/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:03:00" }
      },
      "images-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/images/{**catch-all}" }
      },
      "company-research-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/company-research/{**catch-all}" },
        "Timeouts": { "RequestTimeout": "00:03:00" }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      },
      "content-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      },
      "workflow-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      },
      "application-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      },
      "job-offer-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      },
      "cv-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://monolith:5000" }
        }
      }
    }
  }
}
